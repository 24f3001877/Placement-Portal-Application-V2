# RecruitRadar — Environment Configuration
# Copy this file to .env and fill in values as needed.
# Most defaults work out of the box for local development.

# ── Flask
RR_SECRET_KEY=change-this-to-a-random-secret
FLASK_ENV=development

# ── JWT
JWT_SECRET_KEY=change-this-jwt-secret-too

# ── Redis (WSL: run `sudo service redis-server start` in WSL terminal) ───────
REDIS_URL=redis://localhost:6379/0

# ── Mail — Mailpit (local email testing, no real emails sent) ────────────────
# 1. Download Mailpit: https://github.com/axllent/mailpit/releases
# 2. Run: mailpit        (keep running in a terminal)
# 3. View caught emails: http://localhost:8025
# No changes needed below — defaults point to Mailpit automatically.
MAIL_SERVER=localhost
MAIL_PORT=1025
ADMIN_EMAIL=admin@recruitradar.local

# ── Admin seed credentials (used by init_db.py) ──────────────────────────────
ADMIN_EMAIL_SEED=admin@recruitradar.com
ADMIN_PASSWORD_SEED=Admin@1234
